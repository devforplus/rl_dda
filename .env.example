# 🚀 RL-DDA 게임 환경 설정 예제 파일
# 이 파일을 복사하여 .env 파일을 만들고 필요에 따라 값을 수정하세요.
# cp .env.example .env

# ===== 성능 최적화 설정 =====
# 고성능 캡쳐 모드 활성화 (true/false)
# FastCapture 클래스를 사용하여 3-10배 빠른 성능 제공
ENABLE_FAST_CAPTURE=true

# 캡쳐 간격 설정 (프레임 단위)
# 데이터 수집 시 몇 프레임마다 캡쳐할지 설정 (높을수록 성능 향상)
CAPTURE_INTERVAL=5

# 성능 로깅 활성화 (true/false)
# 캡쳐 성능 통계를 콘솔에 출력할지 설정
ENABLE_PERFORMANCE_LOGGING=true

# ===== 데이터 수집 설정 =====
# 데이터 자동 수집 활성화 (true/false)
# 게임 시작 시 자동으로 데이터 수집을 시작할지 설정
AUTO_COLLECT_DATA=false

# 수집할 최대 프레임 수 (0 = 무제한)
# 메모리 사용량 제한을 위한 최대 프레임 수 설정
MAX_COLLECTED_FRAMES=1000

# ===== 개발자 설정 =====
# 개발 모드 활성화 (true/false)
# 디버그 메시지 및 추가 정보 출력
DEBUG_MODE=false

# 웹 환경 강제 설정 (true/false, 테스트용)
# 로컬 환경에서도 웹 환경으로 테스트할 때 사용
FORCE_WEB_MODE=false

# AI 에이전트 자동 활성화 (true/false)
# 게임 시작 시 AI 에이전트를 자동으로 활성화할지 설정
ENABLE_AI_AGENT=false

# ===== 게임 설정 =====
# 게임 화면 크기 (픽셀)
# pyxel 게임 창의 내부 해상도 설정
GAME_WIDTH=256
GAME_HEIGHT=192

# 게임 FPS (초당 프레임 수)
# 게임 실행 속도 설정 (권장: 60)
GAME_FPS=60

# 디스플레이 스케일 (배율)
# 실제 화면에 표시될 크기 배율 (3 = 768x576 픽셀로 표시)
DISPLAY_SCALE=3

# ===== 사용 예제 =====
# 고성능 데이터 수집 모드:
# ENABLE_FAST_CAPTURE=true
# CAPTURE_INTERVAL=1
# AUTO_COLLECT_DATA=true
# ENABLE_PERFORMANCE_LOGGING=true

# 일반 게임 플레이 모드:
# ENABLE_FAST_CAPTURE=true
# CAPTURE_INTERVAL=5
# AUTO_COLLECT_DATA=false
# DEBUG_MODE=false

# AI 에이전트 테스트 모드:
# ENABLE_AI_AGENT=true
# AUTO_COLLECT_DATA=true
# DEBUG_MODE=true
# ENABLE_PERFORMANCE_LOGGING=true 