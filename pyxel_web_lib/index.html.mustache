<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <script src="{{pyxel_js_url}}"></script>
    <style>
        body {
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: {{background_color}};
            color: {{text_color}};
            {{#font_family}}
            font-family: {{font_family}};
            {{/font_family}}
        }

        {{pyxel_element}} {
            border: 1px solid {{border_color}};
        }

        {{#loading_enabled}}
        .loading-message {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: {{text_color}};
            font-size: {{loading_font_size}};
            z-index: 100;
        }

        /* 404 오류 메시지 숨기기 */
        .console-error {
            display: none;
        }
        {{/loading_enabled}}
    </style>
</head>

<body>
    {{#loading_enabled}}
    <div class="loading-message" id="loading">{{loading_message}}</div>
    {{/loading_enabled}}

    <!--
        {{#comments}}
        root="{{root}}": {{root_description}}
        name="{{name}}": {{name_description}}
        gamepad="{{gamepad}}": {{gamepad_description}}
        packages="{{packages}}": {{packages_description}}
        {{/comments}}
    -->
    <{{pyxel_element}} 
        root="{{root}}" 
        name="{{name}}" 
        {{#gamepad}}gamepad="{{gamepad}}"{{/gamepad}}
        {{#packages}}packages="{{packages}}"{{/packages}}
    ></{{pyxel_element}}>

    {{#loading_enabled}}
    <script>
        // 게임이 로드되면 로딩 메시지 숨기기
        window.addEventListener('load', function() {
            setTimeout(() => {
                const loading = document.getElementById('loading');
                if (loading) {
                    loading.style.display = 'none';
                }
            }, {{loading_timeout}});
        });

        {{#filter_console_errors}}
        // 404 오류 메시지를 콘솔에서 필터링 (선택사항)
        const originalConsoleError = console.error;
        console.error = function(...args) {
            const message = args.join(' ');
            {{#filtered_errors}}
            if (message.includes('{{.}}')) {
                return;
            }
            {{/filtered_errors}}
            originalConsoleError.apply(console, args);
        };
        {{/filter_console_errors}}
    </script>
    {{/loading_enabled}}
</body>

</html> 